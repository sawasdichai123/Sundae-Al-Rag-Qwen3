# ═══════════════════════════════════════════════════════════════════
# SUNDAE — Production Environment Variables
#
# Copy this file:  cp .env.production.example .env.production
# Fill in ALL values before running docker-compose.production.yml
#
# SECURITY: Never commit .env.production to version control!
# ═══════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
APP_NAME=SUNDAE API
DEBUG=false

# ── Supabase (Cloud) ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Domain (ใส่เมื่อรู้ domain จริง) ─────────────────────────────
# Backend API URL — ใช้สร้าง LINE Webhook URL
PUBLIC_API_URL=https://api.yourdomain.com
# Frontend URL — ใช้ใน invitation email link
FRONTEND_URL=https://yourdomain.com

# ── Frontend build args (ใช้ใน docker-compose.production.yml) ───
# ใส่ไว้ที่นี่เพื่อให้ docker compose อ่านได้
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
# ใช้ domain จริงเมื่อ verify DNS ใน Resend แล้ว
EMAIL_FROM=noreply@yourdomain.com

# ── LINE Platform ────────────────────────────────────────────────
LINE_CHANNEL_SECRET=your-line-channel-secret
# AES-256-GCM key — generate: python -c "import secrets; print(secrets.token_hex(32))"
LINE_ENCRYPTION_KEY=your-64-char-hex-key

# ── Ollama / LLM ────────────────────────────────────────────────
# ถูก override ใน docker-compose.production.yml → http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434
# เลือก model ตามสเปค server:
#   qwen3:8b   — RAM ~10 GB
#   qwen3:14b  — RAM ~18 GB (แนะนำ)
#   qwen3:32b  — RAM ~40 GB
LLM_MODEL=qwen3:14b

# ── Embedding ────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ── Reranker ─────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_SCORE_THRESHOLD=0.5

# ── Chunking ─────────────────────────────────────────────────────
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50

# ── Vector Search ────────────────────────────────────────────────
VECTOR_SEARCH_TOP_K=20

# ── Cache (Optional — Redis สำหรับ multi-worker) ─────────────────
# REDIS_URL=redis://redis:6379/0
