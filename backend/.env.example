# ═══════════════════════════════════════════════════════════════════
# SUNDAE Backend — Environment Variables
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control!
# ═══════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
APP_NAME=SUNDAE API
DEBUG=false   # ตั้งเป็น true เฉพาะ development เท่านั้น

# ── Supabase (Self-Hosted) ───────────────────────────────────────
# Get these values from your Supabase dashboard / docker config
SUPABASE_URL=http://your-supabase-host:8000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_DB_URL=postgresql://postgres:postgres@your-db-host:5432/postgres

# ── Email (Resend) ───────────────────────────────────────────────
# Get API key from resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
# Sender address — use onboarding@resend.dev for testing (no domain setup needed)
# For production, use your verified domain: noreply@yourdomain.com
EMAIL_FROM=onboarding@resend.dev
# Frontend URL used in invitation email links
FRONTEND_URL=http://localhost:5173

# ── LINE Platform ────────────────────────────────────────────────
# Get from LINE Developers Console → Channel → Basic settings
LINE_CHANNEL_SECRET=your-line-channel-secret-here

# AES-256-GCM key for encrypting LINE secrets stored in DB
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LINE_ENCRYPTION_KEY=your-64-char-hex-key-here

# ── Ollama / LLM ────────────────────────────────────────────────
# When running with Docker Compose, this is overridden to:
#   http://ollama:11434
# For local development without Docker, keep localhost:
OLLAMA_BASE_URL=http://localhost:11434
# เลือก model ตามสเปค RAM ของเครื่อง:
#   qwen2.5:3b   — RAM ~4 GB  (แนะนำสำหรับเครื่อง RAM น้อย)
#   qwen2.5:7b   — RAM ~8 GB
#   qwen3:14b    — RAM ~16 GB (คุณภาพสูงสุด แต่ต้องการ RAM มาก)
LLM_MODEL=qwen2.5:3b

# ── Embedding ────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ── Reranker ─────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_SCORE_THRESHOLD=0.5

# ── Chunking ─────────────────────────────────────────────────────
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50

# ── Vector Search ────────────────────────────────────────────────
VECTOR_SEARCH_TOP_K=20
