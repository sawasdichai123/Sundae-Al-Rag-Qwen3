เปลี่ยน column `full_name` เป็น `first_name` + `last_name` (รันบน DB แล้ว)

```sql
-- 1. Index + RLS สำหรับ org_members (table สร้างไปแล้ว)
CREATE INDEX idx_org_members_user ON org_members(user_id);
CREATE INDEX idx_org_members_org ON org_members(organization_id);
ALTER TABLE org_members ENABLE ROW LEVEL SECURITY;

-- 2. Migrate data: user_profiles.organization_id → org_members
INSERT INTO org_members (user_id, organization_id, org_role)
SELECT id, organization_id, 'member'
FROM user_profiles
WHERE organization_id IS NOT NULL
ON CONFLICT DO NOTHING;

-- 3. Invitation table
CREATE TABLE IF NOT EXISTS org_invitations (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    organization_id UUID REFERENCES organizations(id) ON DELETE CASCADE,
    invited_email TEXT NOT NULL,
    invited_by UUID REFERENCES auth.users(id),
    status TEXT DEFAULT 'pending' CHECK (status IN ('pending','accepted','revoked')),
    created_at TIMESTAMPTZ DEFAULT now()
);
CREATE INDEX idx_invitations_email ON org_invitations(invited_email);
CREATE INDEX idx_invitations_org ON org_invitations(organization_id);
```

